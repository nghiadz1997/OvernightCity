# ==========================================
# NSG SUPPORT - MÔI TRƯỜNG CẤU HÌNH HỆ THỐNG
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5000

# Firebase Admin SDK Configuration
# Đường dẫn tới file serviceAccountKey.json tải từ Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Hoặc cấu hình biến trực tiếp (cho Vercel / Cloud Run / Heroku):
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Telegram Bot Integration (Server-side Only)
# Lưu ý: Tuyệt đối không để lộ token này ra phía Client JavaScript
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Chat ID của Group tiếp nhận / Trưởng phòng kỹ thuật để nhận thông báo tức thì
TELEGRAM_MANAGER_CHAT_ID=-1001234567890

# Zalo Official Account Integration (Placeholder Architecture)
ZALO_OA_ENABLED=false
ZALO_OA_APP_ID=your_zalo_app_id
ZALO_OA_SECRET_KEY=your_zalo_secret_key
ZALO_OA_ACCESS_TOKEN=your_zalo_access_token

# Security & Upload Controls
UPLOAD_MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# SMTP Email Configuration (Gửi email xác nhận & cập nhật tiến độ)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NSG SUPPORT" <support@your-domain.com>

